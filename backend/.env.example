# Supabase Postgres — pooled connection (PgBouncer, port 6543), used by the running app.
# See SUPABASE_SETUP.md for where to find these.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection (port 5432), used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<direct-host>:5432/postgres"

PORT=4000

# Supabase project URL (dashboard → Project Settings → API) — used to verify
# the Bearer token on every /api/* request against Supabase's JWKS (ES256,
# cached in memory, not re-fetched per request).
SUPABASE_URL=

# Seed-only: kim hoe's Supabase Auth UUID (`sub` claim), used to backfill
# ownership of pre-auth dev data — see CLAUDE.md "Environments".
KIM_HOE_AUTH_USER_ID=

# Demo playground account (see CLAUDE.md "Environments"): Supabase Auth UUID
# of a manually-created demo user. Gates POST /api/demo/reset — only that
# user's data can be wiped/reseeded.
DEMO_USER_ID=
